# check-public-safety: allow untracked-path-reference (naming untracked paths is this file's purpose)

# Zorro Log Files
*.log
Log/
diag.txt
joehook_run.txt

# Zorro Data and Cache
History/
Data/
Cache/

# Test outputs and temporary files
test_output.txt
tests/*.txt
tests/*.json
_ul
_ul-*

# Windows system files
Thumbs.db
*.lnk

# Binary files (DLLs and EXEs - keep source code only)
*.dll
*.exe
*.wav
*.chm

# Asset and config files (commented out - you may want to track these)
# Assets.json
# Zorro.ini
# ZorroFix.ini

# Third-party libraries and plugins (already installed)
Plugin/
Plugin64/
Zorro64/

# Screenshots and media
*.png
*.jpg
*.jpeg

# Batch test runners (keep setup scripts)
run_*_test.bat
test_*.bat

# Python cache
__pycache__/
*.pyc

# Zip archives
*.zip

# Editor files
*.swp
*.swo
*~
.vscode/
.vs/

# API definition files (large, binary)
api.def

# Build output (CMake/MSVC generated files)
# build/ is used as both a scripts dir (.bat files) and a CMake output dir.
# Ignore the CMake output files and subdirs but keep .bat scripts tracked.
build/CMakeCache.txt
build/CMakeFiles/
build/cmake_install.cmake
build/*.vcxproj
build/*.vcxproj.filters
build/*.sln
build/*.dll
build/*.exp
build/*.lib
build/*.txt
build/Release/
build/Debug/
build/*.dir/
build/.cmake/
build/x64/
build_vcpkg/
build_prod/
build_ci/
build32/

# Other binary/compiled
*.o
*.obj
*.pdb
nul

# Claude Code config (machine-specific)
.claude/
.claudeignore
CLAUDE.md
AGENTS.md
PRD.md
PROGRESS.md

# Zorro install junctions (create with mklink /J)
Strategy/
include/
Source/

# CI-fetched Zorro SDK (headers extracted from the beta zip — see workflows)
zorro-sdk.zip

# Third-party editors
Notepad++/

# Legacy code (archived locally)
legacy/

# Sprint/project management docs (local only, synced from Linear)
docs/CURRENT_SPRINT.md
docs/PREVIOUS_SPRINT.md
docs/COMPLETED_ISSUES.md
docs/KNOWN_ISSUES.md
docs/LINEAR_SNAPSHOT.md

#-----------------------------------------------------------------------------
# Secrets.
#
# Zorro stores the wallet key entered in the Password field as PLAINTEXT in
# Accounts.csv, and this plugin signs exchange requests with a secp256k1 private
# key. These rules are deliberately broad: a key committed to a public
# repository is compromised the moment it is pushed, and rotating it is the only
# remedy. Prefer a false positive here over a disclosure.
#-----------------------------------------------------------------------------

# Environment files
.env
.env.*
!.env.example

# Zorro account list — plaintext credentials
Accounts.csv
**/Accounts.csv

# Keys, certificates, wallets and token files
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ecdsa*
id_ed25519*
wallet*.json
keystore*.json
secrets*.json
*_api_key*.txt
*_token*.txt
private.key
private*.pem

# Scraped documentation (regenerated locally, not source of truth)
docs/zorro_docs/
docs/hyperliquid_docs/
docs/hyperliquid-api/

# Test triage artifacts (generated output)
tests/TRIAGE_*
tests/README_TRIAGE.md
tests/triage_report.md
tests/generate_triage_report.py

# Stray redirection / accidental files
/null
/refs/
/test_err.txt
/test_out.txt
/.tmp/

# Claude Code build/test state markers (transient)
.claude-build-ok
.claude-test-ok

# Local working notes (not tracked)
docs/REFACTOR_CHECKLIST_v2.md
docs/archive/

# Maintainer working notes at repo root (investigation notes, run captures, etc.)
/*-investigation.md
/parallel_run*.csv
/hl_ws_cadence_*.csv
/REVIEW.md

# Deny list used by scripts/check_public_safety.py. Untracked on purpose: it
# names private strategies, accounts and logs, so publishing it would disclose
# exactly what it exists to protect. See .private-terms.example.
.private-terms
