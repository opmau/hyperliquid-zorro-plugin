# Ignore the CMake output files and subdirs but keep .bat scripts tracked.
build/CMakeCache.txt
build/CMakeFiles/
build/cmake_install.cmake
build/*.vcxproj
build/*.vcxproj.filters
build/*.sln
build/*.dll
build/*.exp
build/*.lib
build/*.txt
build/Release/
build/Debug/
build/*.dir/
build/.cmake/
build/x64/
build_vcpkg/
build_prod/
build32/

# Other binary/compiled
*.o
*.obj
*.pdb
nul

# Claude Code config (machine-specific)
.claude/
.claudeignore
CLAUDE.md
AGENTS.md
PRD.md
PROGRESS.md

# Zorro install junctions (create with mklink /J)
Strategy/
include/
Source/

# Third-party editors
